# Copy to .env for local overrides (the app runs fine with none of these set, using
# SQLite + wide-open CORS, for local development only).

# --- Required in production ---

# Comma-separated list of frontend origins allowed to call this API / connect sockets.
# Example: https://tech-auction.vercel.app,https://auction.yourdomain.com
# Leave unset locally — same-origin dev (via the Vite proxy) needs no entry here.
ALLOWED_ORIGINS=

# The access code organizers type into /admin/login. Pick something only your team knows.
ADMIN_ACCESS_CODE=

# Signs admin session tokens. Any long random string — e.g. `openssl rand -hex 32`.
# The server refuses to boot in production without this set.
SESSION_SECRET=

# --- Database ---

# Leave unset to use the local SQLite file at server/data/tech-auction.db (the default,
# zero-setup path for running everything on one laptop). Set this to a Postgres connection
# string (Neon / Supabase / Railway Postgres all work) to use Postgres instead — same schema,
# same code, same test suite run against either one.
DATABASE_URL=

# --- Misc ---

# Railway/Render set this automatically; only needed for local overrides.
PORT=4000

# Set to "production" when deployed — this also enforces SESSION_SECRET being set.
NODE_ENV=development
