# Copy to .env.local for local overrides. Leave both unset for local dev — Vite's dev
# server proxies /api and /socket.io to http://localhost:4000 (see vite.config.ts), so the
# client never needs to know the backend's address on your laptop.

# The backend's base URL, e.g. https://tech-auction-api.up.railway.app/api
# Must end in /api. Required when the frontend and backend are on different domains
# (Vercel + Railway/Render) — without it the client calls relative /api/... paths, which
# only work when both are served from the same origin.
VITE_API_URL=

# The backend's Socket.IO origin, e.g. https://tech-auction-api.up.railway.app (no path).
# Required for the same cross-origin-deployment reason as VITE_API_URL above.
VITE_SOCKET_URL=
